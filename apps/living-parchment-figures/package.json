{
  "name": "living-parchment-figures",
  "private": true,
  "version": "0.1.0",
  "description": "Living Parchment: Figures. Sketch or swap parts to build a rigged, animated 3D character and export it to Blender and game engines.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "test:e2e": "vite build && node --test --test-concurrency=1 e2e/*.e2e.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "8.3.8"
  }
}
