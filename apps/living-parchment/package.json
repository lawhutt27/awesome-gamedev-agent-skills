{
  "name": "living-parchment",
  "private": true,
  "version": "0.2.0",
  "description": "Living Parchment World-Builder: draw ink strokes on parchment to raise a 2D-HD paper diorama (Phases 1 and 2).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "test:e2e": "vite build && node --test --test-concurrency=1 e2e/*.e2e.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@use-gesture/vanilla": "10.3.1",
    "simplex-noise": "4.0.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "8.3.8"
  }
}
